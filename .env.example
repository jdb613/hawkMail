# Copy this file to .env and replace placeholders locally.
DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@DB_HOST:5432/DB_NAME
SECRET_KEY=replace-with-a-new-random-secret
MAIL_SERVER=smtp.example.com
MAIL_USERNAME=user@example.com
MAIL_PASSWORD=replace-with-a-new-mail-password
ADMIN_EMAIL=admin@example.com
SENDGRID_API_KEY=replace-with-a-new-sendgrid-api-key
SENDGRID_MAIL=user@example.com
SENDGRID_FROM_EMAIL=sender@example.com
SENDGRID_TO_EMAIL=recipient@example.com
PLAID_CLIENT_ID=replace-with-a-new-plaid-client-id
PLAID_SECRET=replace-with-a-new-plaid-secret
PLAID_PUBLIC_KEY=replace-with-a-new-plaid-public-key-if-required
PLAID_ENV=sandbox
TEST_PLAID_ENV=sandbox
PLOTLY_USERNAME=replace-with-plotly-username
PLOTLY_API_KEY=replace-with-a-new-plotly-api-key
ACCESS_TOKEN_Chase=replace-with-a-new-plaid-access-token
ITEM_ID_Chase=replace-with-plaid-item-id
ACCESS_TOKEN_Chase_SANDBOX=replace-with-a-sandbox-token
ACCESS_TOKEN_Schwab=replace-with-a-new-plaid-access-token
ITEM_ID_Schwab=replace-with-plaid-item-id
ACCESS_TOKEN_Schwab_SANDBOX=replace-with-a-sandbox-token
ACCESS_TOKEN_Lakes=replace-with-a-new-plaid-access-token
ITEM_ID_Lakes=replace-with-plaid-item-id
ACCESS_TOKEN_Lakes_SANDBOX=replace-with-a-sandbox-token
ACCESS_TOKEN_Cap1=replace-with-a-new-plaid-access-token
ITEM_ID_Cap1=replace-with-plaid-item-id
ACCESS_TOKEN_Cap1_SANDBOX=replace-with-a-sandbox-token
HAWK_MODE=test
EXCLUDE_CAT=example-category
LOG_TO_STDOUT=1
